#!/usr/bin/env bash
# wsl-cdp — let AI agents (or you) in WSL2 drive a REAL, logged-in Windows
# browser (Chrome/Edge/Brave) over the Chrome DevTools Protocol.
#
# Why this exists: extension-based agent-browser integrations (e.g. Claude in
# Chrome) ride a native messaging host — the browser spawns the CLI as a child
# process, which cannot cross the WSL2 VM boundary. The working path is raw CDP
# into a dedicated, persistently-logged-in profile, bridged across the NAT.
#
# Chain (every hop loopback-or-WSL-subnet only; see the security note below on
# what "WSL-subnet" does and does NOT isolate on multi-distro machines):
#   WSL 127.0.0.1:9223 (wsl-cdp-forward.py)
#     -> WIN_IP:9224   (netsh portproxy; one-time elevated `wsl-cdp setup-windows`)
#     -> 127.0.0.1:9223 browser --remote-debugging-port (dedicated profile)
#
# Load-bearing details (each is a documented failure mode if changed):
#   - WSL listen port MUST equal the browser's debug port: DevTools echoes the
#     request Host header into webSocketDebuggerUrl, so the advertised
#     ws://127.0.0.1:9223/... only resolves from WSL if the local forward
#     listens on that same port.
#   - portproxy listens on 9224 != 9223 so its wildcard bind can never race the
#     browser's own 127.0.0.1:9223 bind (the stale-rule [::1] self-loop trap).
#   - Chromium 136+ silently IGNORES --remote-debugging-port on the default
#     profile; the dedicated profile is both mandatory and the security
#     boundary (never point agents at your primary profile).
#
# Usage: wsl-cdp <up|down|status|doctor|url|tabs|open URL|close ID|
#                 eval JS [TAB]|text [TAB]|screenshot [FILE] [TAB]|
#                 print-launch|setup-windows|mcp-add>
# Env:   WSL_CDP_PORT=9223  WSL_CDP_PROXY_PORT=9224
#        WSL_CDP_WINUSER=<Windows username>  WSL_CDP_BROWSER=/mnt/c/.../browser.exe
#        WSL_CDP_USERS_ROOT=/mnt/c/Users  (override the Windows users root; testing)
set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PORT="${WSL_CDP_PORT:-9223}"
PROXY_PORT="${WSL_CDP_PROXY_PORT:-9224}"
# Ports are spliced into URLs, jq programs and process patterns: reject anything
# non-numeric up front rather than let it reach a downstream parser.
case "$PORT" in ''|*[!0-9]*) echo "wsl-cdp: WSL_CDP_PORT must be numeric (got '$PORT')" >&2; exit 2 ;; esac
case "$PROXY_PORT" in ''|*[!0-9]*) echo "wsl-cdp: WSL_CDP_PROXY_PORT must be numeric (got '$PROXY_PORT')" >&2; exit 2 ;; esac
STATE="$HOME/.local/state/wsl-cdp"
FWD="$HERE/wsl-cdp-forward.py"
DRIVE="$HERE/wsl-cdp-drive.mjs"
# Overridable roots so detection is unit-testable against a fixture tree without
# touching (or needing) a real Windows C: drive. Defaults = the real paths.
USERS_ROOT="${WSL_CDP_USERS_ROOT:-/mnt/c/Users}"
PROGRAMFILES="${WSL_CDP_PROGRAMFILES:-/mnt/c/Program Files}"
PROGRAMFILES_X86="${WSL_CDP_PROGRAMFILES_X86:-/mnt/c/Program Files (x86)}"

# Anchored match: `--listen-port 9223` must NOT also match `--listen-port 92230`.
# Used by fwd_running AND the pkill calls, so a port-prefix collision can never
# make `up`/`down` kill the wrong forwarder.
FWD_PAT="wsl-cdp-forward\.py .*--listen-port ${PORT}([[:space:]]|\$)"

detect_winuser() {
  # Interop (cmd.exe/powershell.exe) can transiently die on WSL vsock errors —
  # measured on 2026-08-08 with BOTH launchers returning empty for minutes — so
  # interop is tried first but never trusted to be up:
  #   1. cmd.exe (x2), then powershell.exe: the authoritative answers.
  #   2. WSL-username mirror: solo machines usually name both accounts the same.
  #   3. Freshest AppData/Local/Temp: an actively-used profile writes temp
  #      constantly. (Registry-hive mtimes are NOT usable for this: the active
  #      user's NTUSER.DAT is locked and its mtime lags by months through 9p —
  #      measured picking a sandbox profile over the real user.)
  local u d i best="" best_t=0 t
  for i in 1 2; do
    u="$(cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r\n')"
    [ -n "$u" ] && [ -d "$USERS_ROOT/$u" ] && { printf '%s' "$u"; return; }
    sleep 1
  done
  u="$(powershell.exe -NoProfile -Command 'Write-Output $env:USERNAME' 2>/dev/null | tr -d '\r\n')"
  [ -n "$u" ] && [ -d "$USERS_ROOT/$u" ] && { printf '%s' "$u"; return; }
  [ -d "$USERS_ROOT/$USER" ] && { printf '%s' "$USER"; return; }
  for d in "$USERS_ROOT"/*/; do
    d="${d%/}"
    case "${d##*/}" in Public|Default|"Default User"|"All Users") continue ;; esac
    t="$(stat -c %Y "$d/AppData/Local/Temp" 2>/dev/null || echo 0)"
    [ "$t" -gt "$best_t" ] && { best="${d##*/}"; best_t="$t"; }
  done
  [ -n "$best" ] && printf '%s' "$best"
}

browser_candidates() { # rank order: Chrome (system, user), Edge (x86, 64-bit), Brave (user, system)
  # Chrome/Edge outrank Brave (v0.3.1): Chrome is the most common install and
  # Edge ships on every Windows box, so a stock machine works with zero config.
  # Brave is LAST because its updater stages a versioned-install swap that can
  # only complete when no brave.exe runs — when Brave is also the operator's
  # daily browser, the agent instance relaunch-loops on "update pending"
  # (--user-data-dir isolates the profile, not the shared install). Brave still
  # works when it is the only browser, or pinned via WSL_CDP_BROWSER. Once a
  # profile has been launched, profile_browser() outranks this order entirely.
  # Shared by detect_browser AND cmd_browsers so the list the operator sees is
  # BY CONSTRUCTION the list detection walks.
  printf '%s\n' \
    "$PROGRAMFILES/Google/Chrome/Application/chrome.exe" \
    "$WINHOME/AppData/Local/Google/Chrome/Application/chrome.exe" \
    "$PROGRAMFILES_X86/Microsoft/Edge/Application/msedge.exe" \
    "$PROGRAMFILES/Microsoft/Edge/Application/msedge.exe" \
    "$WINHOME/AppData/Local/BraveSoftware/Brave-Browser/Application/brave.exe" \
    "$PROGRAMFILES/BraveSoftware/Brave-Browser/Application/brave.exe"
}

detect_browser() { # first hit wins
  local c
  while IFS= read -r c; do
    [ -x "$c" ] && { printf '%s' "$c"; return; }
  done < <(browser_candidates)
}

profile_browser() {
  # Chromium profiles are not portable across vendors, so the browser that
  # first launched the agent profile must keep owning it: launch_browser()
  # records the exe next to the profile (Windows side, so it travels with the
  # profile, not the distro) and this readback outranks detect_browser() from
  # then on. Without it, any future change in autodetect order would silently
  # reopen a Brave-built profile with Edge/Chrome and orphan every persisted
  # login. WSL_CDP_BROWSER still overrides; a stale record (browser
  # uninstalled) falls through to autodetect instead of blocking.
  local f="$WINHOME/.wsl-cdp/browser" b
  [ -f "$f" ] || return 0
  b="$(cat "$f" 2>/dev/null)"
  [ -n "$b" ] && [ -x "$b" ] && printf '%s' "$b"
  return 0
}

running_of() { # running_of IMAGENAME (e.g. brave.exe) -> true|false|null; memoized
  # tasklist.exe rides WSL interop: when it is down (or absent, as in CI) the
  # honest answer is null/unknown, never false. Memoized per image name because
  # one interop round trip costs ~100-300ms and cmd_browsers may ask repeatedly
  # (user + system installs share an image name).
  local n="$1" var out v
  var="_RUN_${n%%.*}"
  [ -n "${!var:-}" ] && { printf '%s' "${!var}"; return; }
  # </dev/null is load-bearing: cmd_browsers calls this inside a `while read`
  # loop fed by process substitution, and an interop child inheriting that
  # stdin DRAINS it — measured truncating enumeration to one row.
  out="$(tasklist.exe /FO CSV /FI "IMAGENAME eq $n" </dev/null 2>/dev/null | tr -d '\r')"
  if [ -z "$out" ]; then v=null
  elif printf '%s' "$out" | grep -qi "\"$n\""; then v=true
  else v=false; fi
  printf -v "$var" '%s' "$v"
  printf '%s' "$v"
}

cmd_browsers() {
  # Enumerate every INSTALLED candidate in detection rank order, so a human (or
  # the /wsl-cdp:setup flow) can make the vendor choice an explicit decision
  # instead of a silent autodetect — the first launch binds the profile to a
  # vendor (profile_browser), which makes this the choice worth surfacing.
  # Flags: recommended = what autodetect would pick (rank 1);
  #        running     = an instance of that image is live on Windows (a running
  #                      Brave is the update-loop contention warning; a running
  #                      Chrome/Edge is harmless — their swap waits for relaunch);
  #        recorded    = the profile's owner per profile_browser().
  # Text mode emits TSV rows <rank>\t<name>\t<path>\t<flags> (flags "-" if none);
  # --json wraps rows with {selected, source} = what `up` would actually use now.
  resolve_win || return 1
  local rec="" f="$WINHOME/.wsl-cdp/browser"
  [ -f "$f" ] && rec="$(cat "$f" 2>/dev/null)"
  local source="autodetect"
  if [ -n "${WSL_CDP_BROWSER:-}" ]; then source="override"
  elif [ -n "$rec" ] && [ "$rec" = "${BROWSER_EXE:-}" ]; then source="recorded"
  fi
  [ -n "${BROWSER_EXE:-}" ] || source="none"
  local rows=() c rank=0 name run flags
  while IFS= read -r c; do
    [ -x "$c" ] || continue
    rank=$((rank+1))
    name="$(basename "$c" .exe)"; [ "$name" = msedge ] && name=edge
    run="$(running_of "$(basename "$c")")"
    flags=""
    [ "$rank" -eq 1 ] && flags="recommended"
    [ "$run" = true ] && flags="${flags:+$flags,}running"
    [ -n "$rec" ] && [ "$c" = "$rec" ] && flags="${flags:+$flags,}recorded"
    rows+=("$rank"$'\t'"$name"$'\t'"$c"$'\t'"$run"$'\t'"${flags:--}")
  done < <(browser_candidates)
  if [ "${JSON:-0}" = 1 ]; then
    command -v jq >/dev/null 2>&1 || { echo "wsl-cdp: jq required for browsers --json" >&2; return 1; }
    { [ ${#rows[@]} -gt 0 ] && printf '%s\n' "${rows[@]}"; true; } \
      | jq -R 'split("\t") | {rank: (.[0]|tonumber), name: .[1], path: .[2],
               running: (if .[3]=="true" then true elif .[3]=="false" then false else null end),
               recorded: ((.[4]|split(",")|index("recorded")) != null),
               recommended: ((.[4]|split(",")|index("recommended")) != null)}' \
      | jq -s --arg sel "${BROWSER_EXE:-}" --arg src "$source" \
          '{browsers: ., selected: (if $sel=="" then null else $sel end), source: $src}'
  else
    local r a b p fl
    for r in "${rows[@]}"; do
      IFS=$'\t' read -r a b p _ fl <<<"$r"
      printf '%s\t%s\t%s\t%s\n' "$a" "$b" "$p" "$fl"
    done
  fi
  [ ${#rows[@]} -gt 0 ] || { echo "wsl-cdp: no Chrome/Edge/Brave install found (set WSL_CDP_BROWSER)" >&2; return 1; }
}

# Resolved lazily: only commands that touch the Windows side of the launch/setup
# path need the username. status/tabs/eval/etc. must keep working when interop
# is down — hard-failing everything at startup was v0.2.0's bug.
WINUSER="" WINHOME="" BROWSER_EXE="" WIN_DOT="" WIN_PROFILE=""
resolve_win() {
  [ -n "$WINUSER" ] && return 0
  local cache="$STATE/winuser" from_override=0
  WINUSER="${WSL_CDP_WINUSER:-}"
  [ -n "$WINUSER" ] && from_override=1
  if [ -z "$WINUSER" ] && [ -f "$cache" ]; then
    WINUSER="$(cat "$cache" 2>/dev/null)"
    [ -d "$USERS_ROOT/$WINUSER" ] || WINUSER=""
  fi
  [ -z "$WINUSER" ] && WINUSER="$(detect_winuser)"
  if [ -z "$WINUSER" ]; then
    echo "wsl-cdp: cannot detect the Windows username (interop down and no unambiguous $USERS_ROOT profile). Set WSL_CDP_WINUSER." >&2
    return 1
  fi
  # Only persist a DETECTED username. A one-off WSL_CDP_WINUSER override must not
  # poison the cache for later, un-overridden runs.
  [ "$from_override" = 0 ] && { mkdir -p "$STATE" && printf '%s' "$WINUSER" >"$cache"; }
  WINHOME="$USERS_ROOT/$WINUSER"
  # Precedence: explicit env override > the browser recorded as owning the
  # profile > autodetect order.
  BROWSER_EXE="${WSL_CDP_BROWSER:-}"
  [ -z "$BROWSER_EXE" ] && BROWSER_EXE="$(profile_browser)"
  [ -z "$BROWSER_EXE" ] && BROWSER_EXE="$(detect_browser)"
  WIN_DOT="C:\\Users\\$WINUSER\\.wsl-cdp"
  WIN_PROFILE="$WIN_DOT\\profile"
}

win_ip() { ip route show default | awk '{print $3; exit}'; }

launch_argv() {
  # --remote-debugging-port and --user-data-dir are a UNIT: Chromium 136+
  # silently ignores the former without the latter. Do not split them.
  # The last three suppress in-process updater/background churn (v0.3.1), each
  # verified against Chromium/brave-core source:
  #   --disable-background-networking  Playwright/Puppeteer-standard; silences
  #     safe-browsing/translate/variations pings, never page loads or CDP.
  #   --component-update-interval-in-sec  Brave switch (inert on Chrome/Edge:
  #     Chromium ignores unknown switches) stretching Brave's in-process
  #     component-updater cadence to ~1 year.
  #   --check-for-update-interval  stretches InstalledVersionPoller (default
  #     2h), the local staged-update poll behind relaunch-to-update nagging.
  # (--disable-brave-update is deliberately ABSENT: its only consumer is the
  # macOS Sparkle path — dead weight for a Windows-only tool.) None of these
  # stop the OS-side updater (Omaha/BraveSoftwareUpdate scheduled tasks run
  # outside the browser); a staged swap still needs every instance of that
  # browser closed once (README: Brave update loop).
  printf '%s\n' \
    "--remote-debugging-port=$PORT" \
    "--user-data-dir=$WIN_PROFILE" \
    "--remote-allow-origins=*" \
    "--no-first-run" \
    "--no-default-browser-check" \
    "--disable-background-networking" \
    "--component-update-interval-in-sec=31536000" \
    "--check-for-update-interval=31536000"
}

listener_of() { # listener_of PORT -> "pid comm" of any local listener, empty if none
  ss -ltnpH "sport = :$1" 2>/dev/null | head -1 \
    | grep -oP 'pid=\K[0-9]+' | head -1 | while read -r p; do
        printf '%s %s' "$p" "$(tr -d '\0' </proc/"$p"/comm 2>/dev/null || echo '?')"
      done
}

fwd_running() { pgrep -f "$FWD_PAT" >/dev/null 2>&1; }

portproxy_rule() { # prints the portproxy rule line for PROXY_PORT, empty if none
  # netsh.exe rides WSL interop, which can transiently fail (vsock errors) and
  # return empty-with-exit-0. Retry so a one-off blip never reads as "rule
  # missing" — that false negative would block `up` entirely.
  local out i
  for i in 1 2 3; do
    out="$(netsh.exe interface portproxy show v4tov4 2>/dev/null | tr -d '\r' \
      | awk -v p="$PROXY_PORT" '$2 == p {print}')"
    [ -n "$out" ] && { printf '%s' "$out"; return 0; }
    [ "$i" -lt 3 ] && sleep 1
  done
  return 0
}

e2e() { curl -sf -m 3 "http://127.0.0.1:$PORT/json/version"; }
winside() { curl -sf -m 3 "http://$(win_ip):$PROXY_PORT/json/version"; }

start_forwarder() {
  mkdir -p "$STATE"
  setsid nohup python3 "$FWD" --listen-port "$PORT" \
    --target-host "$(win_ip)" --target-port "$PROXY_PORT" \
    >>"$STATE/forwarder.log" 2>&1 &
  sleep 0.4
}

launch_browser() {
  local args=() a
  while IFS= read -r a; do args+=("$a"); done < <(launch_argv)
  # Record what actually owns the profile from here on (see profile_browser).
  # Best-effort: a 9p hiccup must not block the launch itself.
  mkdir -p "$WINHOME/.wsl-cdp" 2>/dev/null && printf '%s' "$BROWSER_EXE" >"$WINHOME/.wsl-cdp/browser" 2>/dev/null
  "$BROWSER_EXE" "${args[@]}" >/dev/null 2>&1 &
  disown
}

cmd_up() {
  # 0. Already reachable end-to-end? Then we are done — this also covers the
  #    mirrored-networking case (browser reachable at 127.0.0.1:$PORT with no
  #    portproxy at all), which the plumbing checks below would wrongly reject.
  local v0
  if v0="$(e2e)"; then
    echo "bridge up: $(printf '%s' "$v0" | jq -r .Browser) at http://127.0.0.1:$PORT"
    return 0
  fi
  # 1. Local port must be free or already ours. Refusing beats fighting:
  #    another listener means another bridge or a misconfigured port.
  local who; who="$(listener_of "$PORT")"
  if [ -n "$who" ] && ! fwd_running; then
    echo "FAIL 127.0.0.1:$PORT is already taken by [$who] and it is not wsl-cdp-forward." >&2
    echo "     Another tool owns this port. Pick a free pair, e.g.:" >&2
    echo "     WSL_CDP_PORT=9225 WSL_CDP_PROXY_PORT=9226 wsl-cdp setup-windows && wsl-cdp up" >&2
    return 1
  fi
  # 2. Windows plumbing present? A passing TCP probe outranks netsh (which can
  #    be interop-down while the rule works fine).
  if [ -z "$(portproxy_rule)" ] && ! winside >/dev/null; then
    echo "FAIL no netsh portproxy rule for port $PROXY_PORT on the Windows side." >&2
    echo "     One-time fix (elevated, UAC): wsl-cdp setup-windows" >&2
    return 1
  fi
  # 3. Browser reachable through the portproxy? If not, launch it and wait.
  if ! winside >/dev/null; then
    resolve_win || return 1
    [ -n "$BROWSER_EXE" ] && [ -x "$BROWSER_EXE" ] || { echo "FAIL no Chrome/Edge/Brave found (set WSL_CDP_BROWSER=/mnt/c/.../browser.exe)" >&2; return 1; }
    echo "launching $(basename "$BROWSER_EXE") (agent profile $WIN_PROFILE)..."
    launch_browser
    local i=0
    until winside >/dev/null || [ $i -ge 20 ]; do
      sleep 1; i=$((i+1))
      [ $((i % 5)) -eq 0 ] && echo "  waiting for the browser to answer on the portproxy... (${i}s)"
    done
    if ! winside >/dev/null; then
      echo "FAIL browser launched but http://$(win_ip):$PROXY_PORT/json/version is unreachable." >&2
      echo "     Likely the inbound firewall rule is missing/stale: rerun wsl-cdp setup-windows," >&2
      echo "     then wsl-cdp doctor for the full chain breakdown." >&2
      return 1
    fi
  fi
  # 4. Forwarder: start, or restart if it targets a stale WIN_IP (reboots change it).
  if fwd_running && ! e2e >/dev/null; then
    pkill -f "$FWD_PAT" 2>/dev/null
    sleep 0.3
  fi
  fwd_running || start_forwarder
  # 5. Prove the whole chain.
  local v; v="$(e2e)" || { echo "FAIL forwarder up but end-to-end check failed; run wsl-cdp doctor" >&2; return 1; }
  echo "bridge up: $(printf '%s' "$v" | jq -r .Browser) at http://127.0.0.1:$PORT"
}

cmd_down() {
  if fwd_running; then
    pkill -f "$FWD_PAT" && echo "forwarder stopped"
  else
    echo "forwarder was not running"
  fi
  echo "(browser window left open — close it in Windows, or leave it for next time)"
}

# render_checks RC ROW... — one status row per arg, each "status<TAB>name<TAB>detail".
# JSON=1 emits {ok,exit,checks:[{status,name,detail}]}; otherwise fixed-column text.
render_checks() {
  local rc="$1"; shift
  if [ "${JSON:-0}" = 1 ]; then
    printf '%s\n' "$@" \
      | jq -R 'split("\t") | {status:.[0], name:.[1], detail:.[2]}' \
      | jq -s --argjson rc "$rc" '{ok: ($rc==0), exit: $rc, checks: .}'
  else
    local r st nm dt
    for r in "$@"; do
      IFS=$'\t' read -r st nm dt <<<"$r"
      printf '%-4s %-14s %s\n' "$st" "$nm" "$dt"
    done
  fi
}

# status: one line per chain link, first broken link sets exit code. Honesty
# rule: the forwarder's own listener being up must never mask a dead Windows
# side, so the Windows side is probed directly.
cmd_status() {
  # TCP probes are ground truth; process identity and netsh output are detail
  # views. A working chain served by a sibling relay (or by mirrored-mode
  # loopback, which needs no relay at all) is a HEALTHY chain.
  local rc=0 wip; wip="$(win_ip)"
  local v who; v="$(e2e)" || v=""; who="$(listener_of "$PORT")"
  local rows=()
  if fwd_running; then
    rows+=("ok"$'\t'"forwarder"$'\t'"127.0.0.1:$PORT -> $wip:$PROXY_PORT")
  elif [ -n "$v" ] && [ -n "$who" ]; then
    rows+=("ok"$'\t'"forwarder"$'\t'"external relay serves 127.0.0.1:$PORT [$who] (not wsl-cdp's own, which is fine)")
  elif [ -n "$v" ]; then
    rows+=("ok"$'\t'"forwarder"$'\t'"not needed: 127.0.0.1:$PORT reachable with no local relay (mirrored networking?)")
  else
    rows+=("FAIL"$'\t'"forwarder"$'\t'"not running (wsl-cdp up)"); rc=1
  fi
  if winside >/dev/null; then
    rows+=("ok"$'\t'"windows-side"$'\t'"http://$wip:$PROXY_PORT (portproxy -> browser)")
  else
    rows+=("FAIL"$'\t'"windows-side"$'\t'"http://$wip:$PROXY_PORT unreachable (browser down? setup-windows not run? firewall?)"); [ $rc -eq 0 ] && rc=2
  fi
  if [ -n "$v" ]; then
    rows+=("ok"$'\t'"end-to-end"$'\t'"$(printf '%s' "$v" | jq -r .Browser)")
  else
    rows+=("FAIL"$'\t'"end-to-end"$'\t'"http://127.0.0.1:$PORT/json/version"); [ $rc -eq 0 ] && rc=3
  fi
  render_checks "$rc" "${rows[@]}"
  return $rc
}

cmd_doctor_json() {
  resolve_win 2>/dev/null || true
  local nv browser jqok rule netmode status_json rc
  nv="$(node --version 2>/dev/null || echo none)"
  browser="none"; [ -n "${BROWSER_EXE:-}" ] && [ -x "${BROWSER_EXE:-}" ] && browser="$BROWSER_EXE"
  jqok=false; command -v jq >/dev/null 2>&1 && jqok=true
  rule="$(portproxy_rule)"
  netmode="$(wslinfo --networking-mode 2>/dev/null || echo unknown)"
  status_json="$(cmd_status)"; rc=$?
  jq -n --argjson st "$status_json" \
        --arg winuser "${WINUSER:-}" --arg browser "$browser" \
        --arg node "$nv" --argjson jq "$jqok" --arg portproxy "${rule:-}" \
        --arg netmode "$netmode" --argjson bport "$PORT" --argjson pport "$PROXY_PORT" \
        '$st + {env: {winuser: $winuser, browser: $browser, node: $node, jq: $jq,
                      portproxy: $portproxy, networking: $netmode,
                      ports: {browser: $bport, portproxy: $pport}}}'
  return $rc
}

cmd_doctor() {
  [ "${JSON:-0}" = 1 ] && { cmd_doctor_json; return $?; }
  echo "== wsl-cdp doctor =="
  echo "ports: browser/wsl-listen=$PORT windows-portproxy=$PROXY_PORT"
  # Soft resolve: doctor reports on every link it can and never dies on one.
  if resolve_win 2>/dev/null; then
    echo "windows-user: $WINUSER (override: WSL_CDP_WINUSER)"
  else
    echo "WARN windows-user  undetected (interop down + ambiguous $USERS_ROOT) — set WSL_CDP_WINUSER; browser check skipped"
  fi
  echo "networking-mode: $(wslinfo --networking-mode 2>/dev/null || echo unknown) (this bridge assumes NAT; under mirrored you may not need the portproxy)"
  if [ -n "$WINUSER" ]; then
    if [ -n "$BROWSER_EXE" ] && [ -x "$BROWSER_EXE" ]; then echo "ok   browser        $BROWSER_EXE"; else echo "FAIL browser        none of Chrome/Edge/Brave found (set WSL_CDP_BROWSER)"; fi
  fi
  local nv; nv="$(node --version 2>/dev/null | tr -dc '0-9.' | cut -d. -f1)"
  [ "${nv:-0}" -ge 22 ] && echo "ok   node           $(node --version) (>=22 needed for eval/screenshot verbs)" || echo "WARN node           ${nv:-none} <22: eval/text/screenshot verbs unavailable"
  if command -v jq >/dev/null 2>&1; then echo "ok   jq             $(jq --version)"; else echo "FAIL jq             not found — tabs/open/close/mcp-add all depend on it"; fi
  # Other WSL2 distros share this distro's network namespace, so they can reach
  # the relay's loopback port directly — the Windows firewall does NOT isolate
  # them. Warn when any exist (see the README security note). Two gotchas:
  # `wsl.exe -l -q` emits UTF-16LE (NUL-separated) — strip NULs to get ASCII
  # names; and the current distro comes from $WSL_DISTRO_NAME ($wslinfo --name
  # is empty on some builds), so filter that out to list only the OTHERS.
  local cur others
  cur="${WSL_DISTRO_NAME:-$(wslinfo --name 2>/dev/null | tr -d '\r\0')}"
  others="$(wsl.exe -l -q 2>/dev/null | tr -d '\0\r' | grep -v -i -x -F "$cur" | grep -v '^[[:space:]]*$' | paste -sd, - 2>/dev/null || true)"
  [ -n "$others" ] && echo "WARN co-distros     other WSL2 distros share this network namespace and can reach 127.0.0.1:$PORT (the debug port has no auth): $others"
  local rule; rule="$(portproxy_rule)"
  if [ -n "$rule" ]; then
    echo "ok   portproxy      $rule"
  elif winside >/dev/null; then
    # netsh rides WSL interop and can be down while the rule works fine; the
    # TCP probe through the rule is the proof that matters (issue #4).
    echo "ok   portproxy      netsh unverifiable (interop down) — proven working by the windows-side probe"
  else
    echo "FAIL portproxy      no v4tov4 rule for $PROXY_PORT — run: wsl-cdp setup-windows"
  fi
  # Stale-rule detection: ANY portproxy rule listening on the browser's own port
  # can grab 127.0.0.1:$PORT before the browser binds it, pushing it to [::1].
  local stale; stale="$(netsh.exe interface portproxy show v4tov4 2>/dev/null | tr -d '\r' | awk -v p="$PORT" '$2 == p {print}')"
  [ -n "$stale" ] && echo "WARN stale rule     a portproxy rule listens on the browser's port $PORT — this races the browser's own bind; delete it (setup-windows does): $stale"
  cmd_status
  local rc=$?
  if [ $rc -ne 0 ]; then
    echo "-- remediation order: setup-windows (once, elevated) -> wsl-cdp up -> doctor"
  else
    echo "-- chain healthy. Agent surface: wsl-cdp tabs|open|eval|text|screenshot, or mcp-add for chrome-devtools-mcp."
  fi
  return $rc
}

cmd_setup_windows() {
  no_args "$@"
  resolve_win || return 1
  command -v python3 >/dev/null 2>&1 || { echo "wsl-cdp: python3 required for setup-windows" >&2; return 1; }
  # TOCTOU-free elevation: pass the setup script body INLINE via -EncodedCommand
  # instead of staging a file and elevating that path. A staged file at a
  # predictable, same-user-writable path can be swapped by a co-resident process
  # between the copy and the UAC click, and the elevated shell would then run the
  # attacker's version. Inline leaves no on-disk artifact to swap.
  local ps1 wrapped b64
  ps1="$(cat "$HERE/wsl-cdp-setup.ps1")"
  # Run the whole script (incl. its own param block) as a scriptblock so we can
  # bind -ProxyPort/-BrowserPort; the elevated process is already admin, so the
  # script's self-elevation branch is skipped.
  wrapped="& { $ps1 } -ProxyPort $PROXY_PORT -BrowserPort $PORT"
  b64="$(printf '%s' "$wrapped" | python3 -c 'import sys,base64;sys.stdout.write(base64.b64encode(sys.stdin.buffer.read().decode("utf-8","surrogateescape").encode("utf-16-le")).decode())')" \
    || { echo "wsl-cdp: failed to encode the setup script" >&2; return 1; }
  echo "Triggering elevated Windows setup (UAC prompt on the Windows side)..."
  powershell.exe -NoProfile -Command \
    "Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-EncodedCommand','$b64'" \
    2>/dev/null || true
  local i=0
  until [ -n "$(portproxy_rule)" ] || [ $i -ge 24 ]; do
    sleep 5; i=$((i+1))
    [ $((i % 3)) -eq 0 ] && echo "  waiting for the portproxy rule to appear... ($((i*5))s; confirm the UAC prompt on Windows)"
  done
  if [ -n "$(portproxy_rule)" ]; then
    echo "ok   portproxy rule present: $(portproxy_rule)"
  else
    # Fallback only: stage the script so the operator can run it themselves in an
    # elevated shell. Operator-initiated and synchronous, unlike the wait above.
    mkdir -p "$WINHOME/.wsl-cdp"
    cp "$HERE/wsl-cdp-setup.ps1" "$WINHOME/.wsl-cdp/wsl-cdp-setup.ps1"
    echo "Timed out waiting for the rule (UAC not confirmed?). Paste-ready manual path:"
    echo "  elevated PowerShell> powershell -NoProfile -ExecutionPolicy Bypass -File $WIN_DOT\\wsl-cdp-setup.ps1 -ProxyPort $PROXY_PORT -BrowserPort $PORT"
    return 1
  fi
}

cmd_mcp_add() {
  no_args "$@"
  # Writes ./.mcp.json (per-repo) — deliberately NOT a global registration:
  # stdio MCP servers spawn one process per agent session, and most sessions
  # never browse. Register where deep browser work actually happens.
  command -v jq >/dev/null 2>&1 || { echo "wsl-cdp: jq required for mcp-add" >&2; return 1; }
  local f="$PWD/.mcp.json" tmp
  tmp="$(mktemp)"
  if jq -n --slurpfile cur <(cat "$f" 2>/dev/null || echo '{}') \
        --arg url "http://127.0.0.1:$PORT" '
        ($cur[0] // {}) as $c
        | $c * {mcpServers: (($c.mcpServers // {}) + {"chrome-devtools": {
            command: "npx",
            args: ["-y", "chrome-devtools-mcp@latest", "--browserUrl", $url]
          }})}' >"$tmp" && mv "$tmp" "$f"; then
    echo "wrote chrome-devtools server to $f (bridge URL http://127.0.0.1:$PORT)"
    echo "next: restart your agent session in this repo and approve the server when prompted"
  else
    rm -f "$tmp"
    echo "wsl-cdp: FAILED to update $f — is it valid JSON? (left unchanged)" >&2
    return 1
  fi
}

need_chain() { e2e >/dev/null || { echo "bridge not up (wsl-cdp up; doctor for detail)" >&2; exit 1; }; }
need_node() {
  local nv; nv="$(node --version 2>/dev/null | tr -dc '0-9.' | cut -d. -f1)"
  [ "${nv:-0}" -ge 22 ] 2>/dev/null || { echo "wsl-cdp: node >=22 required for eval/text/screenshot (found: $(node --version 2>/dev/null || echo none))" >&2; exit 1; }
}
cdp_fail() { # endpoint curl_rc — need_chain already proved /json/version, so a
             # per-endpoint failure is specific, not "bridge down".
  echo "wsl-cdp: CDP request to $1 failed (curl exit ${2:-?}); the bridge answers /json/version but not this call — run: wsl-cdp doctor" >&2
  exit 1
}

print_usage() {
  cat <<'EOF'
usage: wsl-cdp <command>
  up | down | status [--json] | doctor [--json] | url    bridge lifecycle + health
  tabs [--json] | open URL | close ID                     tab management (HTTP CDP)
  eval JS [TAB] | text [TAB]                              page access (needs node >=22)
  screenshot [FILE] [TAB]
  browsers [--json]                          installed browsers in autodetect rank
                                             order + recommended/running/recorded
  print-launch                               show the exact browser command line
  setup-windows                              one-time elevated Windows half (UAC)
  mcp-add                                    per-repo chrome-devtools-mcp entry

Machine output: status/doctor/tabs/browsers accept --json. tabs/open emit TSV
rows: <id>\t<url>; browsers emits <rank>\t<name>\t<path>\t<flags>.
Exit codes: 0 ok · 1 chain/forwarder down · 2 usage/invalid argument · 3 end-to-end fail.
Env: WSL_CDP_PORT WSL_CDP_PROXY_PORT WSL_CDP_WINUSER WSL_CDP_BROWSER WSL_CDP_USERS_ROOT
EOF
}

cmd="${1:-}"; shift 2>/dev/null || true
no_args() { [ $# -eq 0 ] || { echo "wsl-cdp: '$cmd' takes no arguments (got: $*)" >&2; exit 2; }; }

# Help is an explicit success on stdout; a typo is an error on stderr. An agent
# probing capability with `wsl-cdp --help; echo $?` must read 0, not 2.
case "$cmd" in -h|--help|help) print_usage; exit 0 ;; esac

# status/doctor/tabs accept --json and nothing else. Rejecting any other flag or
# positional (rather than silently ignoring it) is the point: a wrong guess like
# `tabs --xml` must be a loud error, never a success exit with the default output.
JSON=0
case "$cmd" in
  status|doctor|tabs|browsers)
    for arg in "$@"; do case "$arg" in
      --json) JSON=1 ;;
      -*) echo "wsl-cdp: unknown option '$arg' for '$cmd' (supported: --json)" >&2; exit 2 ;;
      *) echo "wsl-cdp: '$cmd' takes no positional arguments (got '$arg')" >&2; exit 2 ;;
    esac; done ;;
esac

case "$cmd" in
  up)            no_args "$@"; cmd_up ;;
  down)          no_args "$@"; cmd_down ;;
  status)        cmd_status ;;
  doctor)        cmd_doctor ;;
  url)           no_args "$@"; echo "http://127.0.0.1:$PORT" ;;
  browsers)      cmd_browsers ;;
  print-launch)  no_args "$@"; resolve_win || exit 1
                 { printf '%s ' "$BROWSER_EXE"; launch_argv | tr '\n' ' '; echo; } ;;
  tabs)          need_chain
                 body="$(curl -sf -m 5 "http://127.0.0.1:$PORT/json/list")" || cdp_fail "/json/list" $?
                 if [ "$JSON" = 1 ]; then
                   printf '%s' "$body" | jq '[.[] | select(.type=="page") | {id, url}]'
                 else
                   printf '%s' "$body" | jq -r '.[] | select(.type=="page") | [.id, .url] | @tsv'
                 fi ;;
  open)          [ $# -ge 1 ] || { echo "usage: wsl-cdp open URL" >&2; exit 2; }
                 url="$1"; need_chain
                 u="$(jq -rn --arg u "$url" '$u|@uri')"
                 body="$(curl -sf -m 10 -X PUT "http://127.0.0.1:$PORT/json/new?$u")" || cdp_fail "/json/new" $?
                 printf '%s' "$body" | jq -r '[.id, .url] | @tsv' ;;
  close)         [ $# -ge 1 ] || { echo "usage: wsl-cdp close TAB_ID" >&2; exit 2; }
                 id="$1"
                 case "$id" in *[!0-9A-Fa-f-]*) echo "wsl-cdp: invalid tab id '$id' (expected a CDP hex id from wsl-cdp tabs)" >&2; exit 2 ;; esac
                 need_chain
                 curl -sf -m 5 "http://127.0.0.1:$PORT/json/close/$id" || cdp_fail "/json/close/$id" $? ;;
  eval)          [ $# -ge 1 ] || { echo "usage: wsl-cdp eval JS [TAB_ID]" >&2; exit 2; }
                 js="$1"; need_node; need_chain
                 WSL_CDP_PORT="$PORT" node "$DRIVE" eval "$js" "${2:-}" ;;
  text)          need_node; need_chain
                 WSL_CDP_PORT="$PORT" node "$DRIVE" text "${1:-}" ;;
  screenshot)    need_node; need_chain
                 WSL_CDP_PORT="$PORT" node "$DRIVE" screenshot "${1:-/tmp/wsl-cdp-$$.png}" "${2:-}" ;;
  setup-windows) cmd_setup_windows "$@" ;;
  mcp-add)       cmd_mcp_add "$@" ;;
  *)             print_usage >&2; exit 2 ;;
esac
